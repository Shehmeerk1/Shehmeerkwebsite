# Public site URL (used for metadata, sitemap, canonical links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Lead delivery. Without this, leads are written to .data/leads.jsonl in local
# development and REJECTED in production (the forms say so honestly).
# Point this at your CRM, Zapier, Make, or n8n webhook. Receives JSON (see docs/LEADS.md).
LEADS_WEBHOOK_URL=
# Optional shared secret, sent as the "x-leads-secret" header to the webhook.
LEADS_WEBHOOK_SECRET=

# Signs the download links for gated resources. Required in production.
LEAD_TOKEN_SECRET=

# Optional: a booking link (Calendly, Cal.com, etc.). Enables "Schedule a conversation" buttons.
NEXT_PUBLIC_SCHEDULING_URL=

# Set to "false" before launch to hide the turquoise draft notes.
NEXT_PUBLIC_SHOW_DRAFT_NOTES=true

# Listings source: "demo" (bundled sample data) until an IDX provider is connected.
LISTINGS_PROVIDER=demo
